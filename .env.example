# --- DATABASE CONFIG ---
POSTGRES_USER=empathi_user
POSTGRES_PASSWORD=empathi_password
POSTGRES_DB=empathi_db
DB_HOST=db
DB_PORT=5432

# SQLAlchemy URL for Backend
DATABASE_URL=postgresql://empathi_user:empathi_password@db:5432/empathi_db

# --- BACKEND CONFIG ---
SECRET_KEY=DEVELOPMENT_ONLY_INSECURE_KEY_REPLACE_ME_IN_PRODUCTION
DEBUG=True
APP_NAME=EmpathI

# ML Settings
MODEL_PATH=ml_artifacts/ranker_model.pkl

# --- FRONTEND CONFIG ---
VITE_API_URL=http://localhost:8000


# ==========================================
# BACKEND .ENV.EXAMPLE MERGED CONTENT (DO NOT DELETE)
# ==========================================
# Backend Configuration - Copy to .env and fill in actual values
# === Authentication & Security ===
# SECRET_KEY=your-super-secret-key-min-32-chars-in-production
# ALGORITHM=HS256

# === CORS Configuration ===
# Comma-separated list of allowed frontend origins
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# === Database ===
# DATABASE_URL=sqlite:///./empathi.db
# For PostgreSQL: postgresql://user:password@localhost:5432/empathi_db

# === Logging ===
# LOG_LEVEL=INFO

# === ML Model Path ===
# ML_MODEL_PATH=ml_artifacts/ranker_model.pkl

# === Server ===
# HOST=0.0.0.0
# PORT=8000
# RELOAD=true

#SUPABASE
# SUPABASE_URL="https://{project_key}.supabase.co"
# SUPABASE_KEY="sb_secret_key"

#HUGGING FACE
# HUGGINGFACE_API_KEY=hf_access_key


